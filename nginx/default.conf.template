# nginx do front do UniDash (modelo: ${BACK_URL} e ${EMBED_HUB_ORIGIN} vêm das variáveis do app).
# Explicação de cada bloco em docs/deploy.md.

server {
    listen 80;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 1m;

    # Chamadas da tela ao back (o back não fica exposto na internet; só o nginx fala com ele)
    location /api/ {
        proxy_pass ${BACK_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Link de embed: só o Hub pode abrir em iframe.
    # "try_files /index.html" entrega a tela aqui mesmo, sem sair deste bloco (senão o cabeçalho se perde).
    location /embed/ {
        add_header Content-Security-Policy "frame-ancestors ${EMBED_HUB_ORIGIN}" always;
        add_header Cache-Control "no-cache" always;
        try_files /index.html =404;
    }

    # Arquivos do site com nome que muda a cada versão: podem ficar guardados no navegador
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Demais telas (área do time de dados): ninguém de fora abre em iframe
    location / {
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
